# =============================================================================
# MainStreet.shop — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values. NEVER commit .env.local.
#
# SECURITY RULE: Only variables prefixed with NEXT_PUBLIC_ are exposed to the
# browser. Everything else is SERVER-ONLY and must never appear in client code.
# =============================================================================

# --- App -----------------------------------------------------------------
# Canonical production domain. Locally, leave as http://localhost:3000.
NEXT_PUBLIC_APP_URL=https://mainstreet-shops.com
ADMIN_EMAIL=admin@mainstreet-shops.com

# --- MongoDB Atlas (server-only) -----------------------------------------
# Atlas connection string. Create a cluster at cloud.mongodb.com.
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/mainstreet?retryWrites=true&w=majority

# --- Auth.js / NextAuth v5 (server-only) ---------------------------------
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth (console.cloud.google.com > Credentials > OAuth client ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe (Connect + subscriptions) ------------------------------------
STRIPE_SECRET_KEY=sk_test_...                    # server-only
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...   # client-safe
STRIPE_WEBHOOK_SECRET=whsec_...                  # server-only (payments webhook)
STRIPE_CONNECT_CLIENT_ID=ca_...                  # Connect OAuth client id
# Membership Price IDs are auto-created at runtime by lookup_key — no STRIPE_PRICE_* needed.
# Webhook events: payment_intent.succeeded, customer.subscription.created/updated/deleted,
# checkout.session.completed (shipping-adjustment pay-link only).

# --- Storm Lake Pack & Ship Partner API (retail rates + labels) ----------
# The rate source AND the label producer. See docs/slpacknship.md.
# Retail-only: we charge the consumer exactly what the API quotes, no markup.
SLPS_PARTNER_ID=...                              # X-Partner-Id      (server-only)
SLPS_PARTNER_SECRET=...                          # X-Partner-Secret  (server-only)
SLPS_BASE_URL=https://www.slpacknship.com        # optional; defaults to production
# LOCAL ONLY: serve fake rates so checkout is testable without credentials.
# Deliberately an explicit opt-in, NOT a fallback — missing credentials must fail
# closed, because a label can only be produced from a real stored quote.
# Ignored when NODE_ENV=production. Quote ids are prefixed "devstub_".
SLPS_DEV_STUB=0

# --- SL Pack & Ship ops handoff ------------------------------------------
# Still needed for pickup_pack orders ONLY: the Partner API request carries no
# origin/business field, so this email is what tells Storm Lake which local shop to
# collect from and what is in the box. self_ship needs none (they email the label).
SHIPIT_EMAIL=shipit@slpacknship.com              # where pickup_pack orders are emailed

# --- Vercel Blob (object storage; server-only token) ---------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Resend (transactional email; server-only) ---------------------------
RESEND_API_KEY=re_...
# From address MUST be on a Resend-verified domain (currently fyht4.com).
EMAIL_FROM=MainStreet <hello@fyht4.com>

# --- Cron (weekly town digest) -------------------------------------------
# Vercel passes this as a Bearer token to /api/cron/* when set. Any random string.
CRON_SECRET=

# --- Upstash Redis (rate limiting; server-only) --------------------------
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- Google Maps (geocoding + map embed) ---------------------------------
GOOGLE_MAPS_API_KEY=AIza...                      # server-only, for geocoding
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...              # client, restrict to mainstreet.shop referrers

# --- AI (Claude) — event language moderation -----------------------------
# Used to screen community event submissions. If unset, a local keyword screen
# is used as a safe fallback. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# --- Amazon affiliate fallback (Addendum A) ------------------------------
AMAZON_ASSOCIATE_TAG=mainstreetus-20             # server-only, used in affiliate links
NEXT_PUBLIC_AMAZON_STOREFRONT_URL=https://www.amazon.com/shop/mainstreetus
# Product Advertising API (PA-API 5.0) — enables live product + price on empty
# search. Requires an approved Associates account (~3 qualifying sales first).
# Leave blank until approved; the app falls back to affiliate search links.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=

# --- Prospects / mailing list builder (admin only) ------------------------
# Source: Iowa SOS "Active Iowa Business Entities", CC-BY 4.0. ~205 MB per pull, no ETag,
# no Range support. Full contract: docs/vendor/iowa-sos-active-business-entities-v1.md
# NOTE: none of the PROSPECTS_* vars are required - each has a default in code.
# The one var this feature genuinely needs is CRON_SECRET (above), and only so that
# Vercel's nightly cron can authenticate; an admin clicking "Run pass now" uses their session.
PROSPECTS_SOURCE_URL=https://idh-be.iowa.gov/api/v1/datasets/554/rows.json  # server-only
PROSPECTS_SOURCE_USER_AGENT=                     # server-only; identify us + a contact address
PROSPECTS_DEFAULT_STATE=IA                       # server-only; only IA is supported in v1
# Soft deadline for one streaming pass. MUST stay under the route's maxDuration (300s) so the
# pass ends cleanly as "partial" instead of being SIGKILLed with the run lock still held.
PROSPECTS_INGEST_MAX_MS=240000                   # server-only
# --- The rest of this block is for EMAIL CAMPAIGNS, which are not built yet. ---
# Nothing below is required for the city/ZIP lookup, and nothing above it is either:
# every PROSPECTS_* var has a working default in code. Listed here for discoverability.
#
# Signs one-click unsubscribe links. If blank, derived from AUTH_SECRET.
# Must be signed, never a raw record id: Mongo ObjectIds are sequential enough to enumerate,
# and the opt-out list is permanent by design, so poisoning it is not reversible.
PROSPECTS_UNSUBSCRIBE_SECRET=                    # server-only
# REQUIRED before any outreach email can send. CAN-SPAM requires a real physical postal
# address in every commercial message; the send fails closed when this is unset.
PROSPECTS_POSTAL_ADDRESS=                        # server-only
# Use a SEPARATE verified subdomain from transactional mail: cold-outreach complaints would
# otherwise degrade order-confirmation deliverability.
EMAIL_FROM_OUTREACH=                             # server-only, e.g. MainStreet <hello@outreach.fyht4.com>
PROSPECTS_REPLY_TO=                              # server-only; must be a monitored mailbox
PROSPECTS_SEND_RPS=2                             # server-only; Resend pacing (2 free tier, 10 paid)
